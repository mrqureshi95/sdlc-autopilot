{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-supplied replay metadata (not execution proof)",
  "type": "object",
  "required": ["eval_id", "mode", "summary", "agent_name"],
  "properties": {
    "eval_id": {"type": "integer", "minimum": 1},
    "mode": {"type": "string", "enum": ["quick", "standard", "full"]},
    "summary": {"type": "string", "minLength": 1},
    "agent_name": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "agent_surface": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
